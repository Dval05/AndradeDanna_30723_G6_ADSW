@startuml
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false

actor "Jefe de Operaciones Logistica" as Jefe
actor "Administrador del Sistema" as Admin

rectangle "Sistema TekMess - Modulo Reporte" {
  usecase "Generar Reporte" as UC1
  usecase "Consultar Reporte" as UC2
  usecase "Contar Empleados Gestionados" as UC3
  usecase "Contar Empleados Editados" as UC4
  usecase "Obtener Accesos Fallidos" as UC5
}

Jefe --> UC1
Jefe --> UC2
Admin --> UC1
Admin --> UC2

UC1 ..> UC3 : <<include>>
UC1 ..> UC4 : <<include>>
UC1 ..> UC5 : <<include>>

note right of UC1
Origen de datos:
- Gestion de Empleados (RF01)
- Sistema de Autenticacion (RF02)
end note
@enduml
