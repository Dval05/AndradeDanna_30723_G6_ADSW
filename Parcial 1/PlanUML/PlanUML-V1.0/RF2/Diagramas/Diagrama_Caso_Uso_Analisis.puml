@startuml
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false

actor "Usuario" as Usuario
actor "Sistema" as Sistema

rectangle "Sistema TekMess - Modulo Administrar Sistema" {
  usecase "Iniciar Sesion" as UC1
  usecase "Cambiar Contrasena" as UC2
  usecase "Recuperar Contrasena" as UC3
  usecase "Realizar Autenticacion Multifactor" as UC4
  usecase "Validar Credenciales" as UC5
  usecase "Enviar Codigo de Verificacion" as UC6
}

Usuario --> UC1
Usuario --> UC2
Usuario --> UC3

UC1 ..> UC5 : <<include>>
UC1 ..> UC4 : <<include>>
UC4 ..> UC6 : <<include>>
UC3 ..> UC6 : <<include>>

UC1 ..> UC2 : <<extend>>
UC1 ..> UC3 : <<extend>>

note right of UC5
Validaciones criticas:
- Credenciales correctas
- Usuario activo
- Maximo 3 intentos
end note

@enduml
