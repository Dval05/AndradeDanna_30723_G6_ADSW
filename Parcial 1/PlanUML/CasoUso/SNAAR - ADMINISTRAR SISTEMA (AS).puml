@startuml

skinparam actorStyle awesome
left to right direction

skinparam DefaultFontColor black
skinparam BackgroundColor white


actor Usuario


rectangle "SNAAR - ADMINISTRAR SISTEMA (AS)" #White {
    
    
    usecase "Iniciar Sesión" as UC_Iniciar 
    usecase "Recuperar Contraseña" as UC_Recuperar 
    usecase "Cambiar Contraseña" as UC_Cambiar 
    usecase "Realizar Autenticación Multifactor" as UC_Multi
 
}

' Uniones de actores a casos de uso

Usuario--UC_Iniciar
Usuario--UC_Cambiar
Usuario--UC_Multi

UC_Iniciar ..> UC_Recuperar : <<extend>>
UC_Iniciar ..> UC_Multi : <<include>>
UC_Iniciar ..> UC_Cambiar : <<extend>>


'Elaborado David Pilaguano - 2026-05-05 
@enduml