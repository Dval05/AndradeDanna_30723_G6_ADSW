@startuml DiagramaN0_RF3V2_ReporteAnalitico

skinparam actorStyle awesome
left to right direction

skinparam DefaultFontColor black
skinparam BackgroundColor white

skinparam usecase {
    BackgroundColor<<Reporte>> #3C763D
    BorderColor black
    FontColor white
}

actor "Jefe Operativo/\nLogistica" as Jefe
actor "Supervisor"                  as Sup

rectangle "Sistema TekMess - SNAAR\nGenerar Reporte Analitico (RF-03V2)" #White {

    usecase "Generar Reporte\nAnalitico"       as UC1 <<Reporte>>
    usecase "Consultar Historial\nde Reportes" as UC2 <<Reporte>>

}

Jefe--UC1
Jefe--UC2
Sup--UC1
Sup--UC2

note right of UC1
  Origen de datos:
  - Total empleados gestionados <- RF-01
  - Total empleados editados    <- RF-01
  - Total accesos fallidos      <- RF-02V2
end note

note right of UC2
  Acceso segun rol:
  - Jefe: todos los reportes del sistema
  - Supervisor: solo reportes de sus guardias
end note

'Elaborado Grupo 6 - ADSW ESPE - 2026
@enduml
